# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/firstflight?schema=public"
# Where uploaded client documents are stored (use a persistent disk in production)
UPLOAD_DIR="./storage/uploads"
# Password given to the seeded staff and demo accounts (change after first login)
SEED_PASSWORD="choose-a-strong-password"
# Optional: email through Resend. Without these, emails are logged as SKIPPED and only in-app notifications are sent.
RESEND_API_KEY=""
EMAIL_FROM="FIRST FLIGHT <notifications@yourdomain.com>"
# Optional: public address used in email links (Render sets RENDER_EXTERNAL_URL automatically)
APP_URL=""
